+//! Fade the scene over opaque black, never the Wayland lock surface itself.
+use gtk::{glib, prelude::*};
+use std::time::{Duration, Instant};
+
+pub const DURATION: Duration = Duration::from_millis(550);
+
+pub fn enabled() -> bool {
+    std::env::var("DECKLOCK_TRANSITIONS").as_deref() == Ok("1")
+}
+
+fn animate(scene: &gtk::Widget, from: f64, to: f64) {
+    let started = Instant::now();
+    scene.set_opacity(from);
+    scene.add_tick_callback(move |scene, _| {
+        if to > from && scene.has_css_class("transition-exiting") {
+            return glib::ControlFlow::Break;
+        }
+        let t = (started.elapsed().as_secs_f64() / DURATION.as_secs_f64()).min(1.0);
+        let eased = t * t * (3.0 - 2.0 * t);
+        scene.set_opacity(from + (to - from) * eased);
+        if t >= 1.0 {
+            glib::ControlFlow::Break
+        } else {
+            glib::ControlFlow::Continue
+        }
+    });
+}
+
+pub fn attach(window: &gtk::ApplicationWindow, scene: &gtk::Overlay) {
+    let base = gtk::Overlay::new();
+    base.set_widget_name("transition-base");
+    let black = gtk::DrawingArea::new();
+    black.set_draw_func(|_, context, _, _| {
+        context.set_source_rgb(0.0, 0.0, 0.0);
+        let _ = context.paint();
+    });
+    base.set_child(Some(&black));
+    scene.set_widget_name("transition-scene");
+    scene.set_opacity(0.0);
+    base.add_overlay(scene);
+    window.set_child(Some(&base));
+    scene.connect_map(|scene| animate(scene.upcast_ref(), 0.0, 1.0));
+}
+
+/// The caller alone decides whether exiting is authorized. This never unlocks.
+pub fn exit(windows: &[gtk::ApplicationWindow], finished: impl FnOnce() + 'static) {
+    if !enabled() {
+        finished();
+        return;
+    }
+    for window in windows {
+        if let Some(base) = window
+            .child()
+            .filter(|w| w.widget_name() == "transition-base")
+            && let Some(scene) = base.last_child()
+        {
+            scene.set_sensitive(false);
+            scene.add_css_class("transition-exiting");
+            animate(&scene, scene.opacity(), 0.0);
+        }
+    }
+    // A bounded timer still completes when outputs stop producing frame ticks.
+    glib::timeout_add_local_once(DURATION + Duration::from_millis(50), finished);
+}
