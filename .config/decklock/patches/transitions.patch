+//! Isolated GTK lifecycle check. No lock backend, PAM, or power actions.
+use decklock::{
+    config::{Config, Theme},
+    i18n::I18n,
+    ui,
+};
+use gtk::{gio, prelude::*};
+use std::{
+    cell::Cell,
+    rc::Rc,
+    time::{Duration, Instant},
+};
+
+fn pump(duration: Duration) {
+    let until = Instant::now() + duration;
+    while Instant::now() < until {
+        for _ in 0..100 {
+            if !gtk::glib::MainContext::default().iteration(false) {
+                break;
+            }
+        }
+        std::thread::sleep(Duration::from_millis(2));
+    }
+}
+
+fn main() {
+    assert!(ui::transitions::enabled());
+    gtk::init().unwrap();
+    let app = gtk::Application::new(
+        Some("io.github.decklock.TransitionsCheck"),
+        gio::ApplicationFlags::NON_UNIQUE,
+    );
+    app.register(None::<&gio::Cancellable>).unwrap();
+    let mut theme = Theme::load(None).unwrap();
+    theme.name = "Burning Crusade".into();
+    theme.layout.clock_visible = false;
+    theme.layout.avatar_visible = false;
+    ui::apply_css(&theme.css).unwrap();
+    let view = ui::build(
+        &app,
+        Rc::new(ui::Settings {
+            config: Config {
+                background_pool: Some(vec![]),
+                idle_enabled: false,
+                system_keyboard: false,
+                ..Config::default()
+            },
+            theme,
+            strings: I18n::new(Some("en-US"), None).unwrap(),
+            preview: true,
+            show_keyboard: false,
+            start_idle: false,
+            username: "Fixture".into(),
+            greeter: false,
+            power_supply: None,
+        }),
+        Rc::new(|_| panic!("Preview must never authenticate")),
+    );
+    let base = view.window.child().unwrap();
+    let scene = base.last_child().unwrap();
+    assert_eq!(base.widget_name(), "transition-base");
+    assert_eq!(scene.opacity(), 0.0);
+    view.window.present();
+    pump(Duration::from_millis(160));
+    assert!(
+        scene.opacity() > 0.0 && scene.opacity() < 1.0,
+        "Entry must have intermediate frames"
+    );
+    assert_eq!(base.opacity(), 1.0, "Opaque base must never fade");
+    assert_eq!(view.window.opacity(), 1.0, "Lock surface must never fade");
+    pump(Duration::from_millis(600));
+    assert_eq!(scene.opacity(), 1.0);
+    let finished = Rc::new(Cell::new(false));
+    let done = finished.clone();
+    ui::transitions::exit(std::slice::from_ref(&view.window), move || done.set(true));
+    pump(Duration::from_millis(160));
+    assert!(
+        scene.opacity() > 0.0 && scene.opacity() < 1.0,
+        "Exit must have intermediate frames"
+    );
+    assert!(!finished.get(), "Completion must wait for the fade");
+    assert!(!scene.is_sensitive(), "No submissions during exit");
+    pump(Duration::from_millis(600));
+    assert_eq!(scene.opacity(), 0.0);
+    assert!(finished.get());
+    assert_eq!(base.opacity(), 1.0);
+    // A hidden output must not leave the authorized completion waiting on ticks.
+    view.window.set_visible(false);
+    let finished = Rc::new(Cell::new(false));
+    let done = finished.clone();
+    ui::transitions::exit(std::slice::from_ref(&view.window), move || done.set(true));
+    pump(Duration::from_millis(700));
+    assert!(finished.get());
+    view.window.destroy();
+    println!("PASS: entry/exit frames, opaque surface, deferred completion, hidden output");
+}
