#!/usr/bin/env bash
# Rebuild the optional local DeckLock variant; retain the original release binary.
set -euo pipefail
decklock_home="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
runtime="$decklock_home/runtime/usr"
build_dir="$(mktemp -d "$decklock_home/runtime/transitions-build-XXXXXX")"
archive="$build_dir/source.tar.gz"
url=https://github.com/yan-vidal/DeckLock/archive/refs/tags/v0.3.6.tar.gz
if ! curl -fL --connect-timeout 10 --max-time 120 "$url" -o "$archive"; then
  proxychains4 curl --proxy '' -fL --connect-timeout 15 --max-time 180 "$url" -o "$archive"
fi
printf '%s  %s\n' ae6737c5f1800961fe8528ecdca795e3efecb0a589003274ded9635256a3e937 "$archive" | sha256sum --check --status
tar -xf "$archive" -C "$build_dir" --strip-components=1
cd "$build_dir"
patch -p1 < "$decklock_home/patches/transitions.patch"
mkdir -p native-pkgconfig
sed "s|^prefix=/usr$|prefix=$runtime|" "$runtime/lib/pkgconfig/gtk4-layer-shell-0.pc" > native-pkgconfig/gtk4-layer-shell-0.pc
export PKG_CONFIG_PATH="$build_dir/native-pkgconfig${PKG_CONFIG_PATH:+:$PKG_CONFIG_PATH}"
export LD_LIBRARY_PATH="$runtime/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export GST_PLUGIN_PATH="$runtime/lib/gstreamer-1.0${GST_PLUGIN_PATH:+:$GST_PLUGIN_PATH}"
export CARGO_TARGET_DIR="$decklock_home/runtime/transitions-target"
if ! cargo fetch --locked; then
  proxychains4 env -u http_proxy -u https_proxy -u HTTP_PROXY -u HTTPS_PROXY -u ALL_PROXY -u all_proxy cargo fetch --locked
fi
cargo fmt --all -- --check
cargo build --locked --offline --bin decklock --example transitions_check -j 3
cargo test --locked --offline --lib --test session_invariants -j 3
test_dir="$(mktemp -d "$build_dir/check-XXXXXX")"
mkdir -p "$test_dir/config" "$test_dir/data" "$test_dir/cache" "$test_dir/runtime"
chmod 700 "$test_dir/runtime"
XDG_CONFIG_HOME="$test_dir/config" XDG_DATA_HOME="$test_dir/data" XDG_CACHE_HOME="$test_dir/cache" XDG_RUNTIME_DIR="$test_dir/runtime" \
  GTK_A11Y=none GDK_BACKEND=x11 GDK_DISABLE=gl GSK_RENDERER=cairo DECKLOCK_TRANSITIONS=1 \
  xvfb-run -a -s '-screen 0 1280x800x24 -nolisten tcp' dbus-run-session -- "$CARGO_TARGET_DIR/debug/examples/transitions_check"
install -m 755 "$CARGO_TARGET_DIR/debug/decklock" "$runtime/bin/decklock-animated.new"
strip "$runtime/bin/decklock-animated.new"
mv -- "$runtime/bin/decklock-animated.new" "$runtime/bin/decklock-animated"
printf 'Animated variant installed. Original release binary preserved. Build: %s\n' "$build_dir"
